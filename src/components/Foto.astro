---
import { Image } from "astro:assets";
import type { ImageMetadata } from "astro";

interface Props {
  etiqueta: string;                         // qué foto es (también es el texto alternativo)
  src?: ImageMetadata | string | null;      // imagen importada (se optimiza) o ruta en /public
  alto?: string;                            // alto máximo, ej: "520px"
  radio?: string;                           // ej: "4px 120px 4px 4px"
  prioridad?: boolean;                      // true solo para la foto principal visible al abrir
  transicion?: string;                      // nombre para que la foto "viaje" entre páginas
}

const { etiqueta, src, alto = "320px", radio = "var(--radio)", prioridad = false, transicion } = Astro.props;
const estilo =
  `height:clamp(240px, 75vw, ${alto});border-radius:${radio}` +
  (transicion ? `;view-transition-name:${transicion}` : "");
---

{src && typeof src !== "string" ? (
  <Image
    class="foto"
    src={src}
    alt={etiqueta}
    widths={[480, 800, 1200, 1600]}
    sizes="(max-width: 700px) 100vw, 50vw"
    loading={prioridad ? "eager" : "lazy"}
    fetchpriority={prioridad ? "high" : "auto"}
    style={estilo}
  />
) : src ? (
  <img class="foto" src={src} alt={etiqueta} loading="lazy" style={estilo} />
) : (
  <div class="foto foto--vacia" style={estilo}>
    <span>Foto: {etiqueta}</span>
  </div>
)}

<style>
  :global(.foto) {
    width: 100%;
    object-fit: cover;
  }
  .foto--vacia {
    background: var(--gris-foto);
    color: var(--texto-suave);
    display: grid;
    place-items: center;
    text-align: center;
    font-size: 15px;
    padding: 24px;
  }
</style>
