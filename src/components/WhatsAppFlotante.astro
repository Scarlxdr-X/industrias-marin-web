---
import { empresa } from "../data/empresa";
---

<a href={empresa.whatsapp} class="wa" aria-label="Escríbenos por WhatsApp" target="_blank" rel="noopener">
  <svg viewBox="0 0 24 24" aria-hidden="true">
    <path d="M21 11.5a8.4 8.4 0 0 1-12.4 7.4L3 20.5l1.6-5.4A8.4 8.4 0 1 1 21 11.5z" />
  </svg>
</a>

<style>
  .wa {
    position: fixed;
    right: 20px;
    bottom: 20px;
    z-index: 20;
    width: 60px;
    height: 60px;
    border-radius: 50%;
    background: #1E8E4E;
    display: grid;
    place-items: center;
    box-shadow: 0 6px 20px rgba(36, 7, 63, 0.25);
    transition: transform 0.15s;
  }
  .wa:hover { transform: scale(1.06); }
  .wa svg {
    width: 28px;
    height: 28px;
    fill: none;
    stroke: #FFFFFF;
    stroke-width: 1.8;
    stroke-linecap: round;
    stroke-linejoin: round;
  }
</style>