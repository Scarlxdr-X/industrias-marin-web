---
import Foto from "./Foto.astro";
import TituloSeccion from "./TituloSeccion.astro";
import { empresa } from "../data/empresa";

// Cuando tengas los logos de los reconocimientos, pon aquí sus rutas
const reconocimientos = ["Reconocimiento 1", "Reconocimiento 2", "Reconocimiento 3"];
---

<section id="nosotros" class="nosotros">
  <div class="contenedor nosotros__interior">
    <div class="nosotros__texto">
      <TituloSeccion etiqueta="Nuestra historia">
        Empezamos en un pequeño local <em>en {empresa.desde}</em>
      </TituloSeccion>
      <p>
        Hoy tenemos una planta propia en El Cerrito y apoyamos el desarrollo de la región,
        comprometidos con cerca de 50 familias. Más de 30 años de reconocimientos y buenas
        relaciones con aliados y colaboradores.
      </p>
      <ul class="nosotros__sellos" aria-label="Reconocimientos">
        {reconocimientos.map((r) => <li>{r}</li>)}
      </ul>
    </div>

    <div class="nosotros__foto">
      <Foto etiqueta="La planta o el equipo de trabajo" alto="420px" radio="4px 4px 120px 4px" />
    </div>
  </div>
</section>

<style>
  .nosotros {
    background: var(--lavanda);
    padding-block: var(--espacio-seccion);
    scroll-margin-top: 90px;
  }
  .nosotros__interior {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 56px;
  }
  .nosotros__texto {
    flex: 1 1 440px;
    min-width: 0;
    display: flex;
    flex-direction: column;
    gap: 24px;
  }
  .nosotros__texto > p { margin: 0; color: #4A4155; }
  .nosotros__foto { flex: 1 1 440px; min-width: 0; }

  .nosotros__sellos {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
  }
  .nosotros__sellos li {
    width: 108px;
    height: 80px;
    border: 1px dashed #CFC6DA;
    border-radius: 4px;
    display: grid;
    place-items: center;
    text-align: center;
    font-size: 12px;
    color: var(--texto-suave);
    padding: 8px;
  }
</style>