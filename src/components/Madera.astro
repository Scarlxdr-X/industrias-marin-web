---
import TituloSeccion from "./TituloSeccion.astro";

const pasos = [
  { n: "01", titulo: "Secado en horno", texto: "Retiramos la humedad de la madera para que no se tuerza ni se agriete con el tiempo." },
  { n: "02", titulo: "Inmunizado", texto: "La protegemos contra insectos y hongos antes de empezar a trabajarla." },
  { n: "03", titulo: "Fabricación propia", texto: "Cada pieza se corta, arma y ensambla en nuestra planta de El Cerrito." },
  { n: "04", titulo: "Acabados", texto: "Lijado, tinte y laca con el color y el brillo que elijas." },
];
---

<section id="calidad" class="madera">
  <div class="contenedor">
    <div class="madera__intro">
      <TituloSeccion etiqueta="Por qué duran" claro>
        La diferencia está <em>antes</em> de cortar la primera pieza
      </TituloSeccion>
      <p data-revelar>
        Antes de empezar la producción tratamos la madera en nuestra planta. Por eso
        podemos garantizar su duración hasta por 5 años.
      </p>
    </div>

    <ol class="madera__pasos">
      {pasos.map((p) => (
        <li data-revelar>
          <span class="madera__numero">{p.n}</span>
          <h3>{p.titulo}</h3>
          <p>{p.texto}</p>
        </li>
      ))}
    </ol>
  </div>
</section>

<style>
  .madera {
    background: var(--morado);
    color: #DCCFEA;
    padding-block: var(--espacio-seccion);
    scroll-margin-top: 90px;
  }
  .madera__intro { max-width: 720px; margin-bottom: 56px; display: grid; gap: 16px; }
  .madera__intro p { margin: 0; }

  .madera__pasos {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(240px, 1fr));
    gap: 40px 32px;
  }
  .madera__pasos li {
    border-top: 2px solid var(--cobre);
    padding-top: 20px;
    display: grid;
    gap: 10px;
  }
  .madera__numero {
    font-family: var(--fuente-titulos);
    font-size: 44px;
    font-weight: 600;
    line-height: 1;
    color: var(--cobre-claro);
  }
  .madera h3 {
    font-family: var(--fuente-texto);
    font-size: 20px;
    color: var(--blanco);
  }
  .madera__pasos p { margin: 0; font-size: 16px; }
</style>