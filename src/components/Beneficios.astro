---
const beneficios = [
  "Muebles a tu medida",
  "Madera inmunizada y garantizada",
  "Excelentes acabados",
  "Responsables con el ambiente",
];
---

<section class="beneficios">
  <ul class="contenedor beneficios__lista">
    {beneficios.map((b) => (
      <li data-revelar>
        <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M20 6 9 17l-5-5" /></svg>
        {b}
      </li>
    ))}
  </ul>
</section>

<style>
  .beneficios {
    background: var(--lavanda);
    border-block: 1px solid var(--borde);
  }
  .beneficios__lista {
    list-style: none;
    margin: 0 auto;
    padding-block: 28px;
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
    gap: 16px 32px;
  }
  .beneficios li {
    display: flex;
    align-items: center;
    gap: 14px;
    font-weight: 500;
  }
  .beneficios svg {
    width: 26px;
    height: 26px;
    flex: none;
    fill: none;
    stroke: var(--cobre);
    stroke-width: 1.8;
    stroke-linecap: round;
    stroke-linejoin: round;
  }
</style>