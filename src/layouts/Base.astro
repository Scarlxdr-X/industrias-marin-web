---
import "../styles/global.css";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import WhatsAppFlotante from "../components/WhatsAppFlotante.astro";

interface Props {
  titulo: string;
  descripcion?: string;
}

const {
  titulo,
  descripcion = "Diseño y fabricación de muebles en madera inmunizada y secada al horno. Alcobas, salas, comedores y cocinas a la medida en El Cerrito, Valle del Cauca.",
} = Astro.props;
---

<html lang="es">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{titulo}</title>
    <meta name="description" content={descripcion} />
    <meta property="og:title" content={titulo} />
    <meta property="og:description" content={descripcion} />
    <meta property="og:type" content="website" />
  </head>
  <body>
    <Header />
    <main>
      <slot />
    </main>
    <Footer />
    <WhatsAppFlotante />
  </body>
</html>