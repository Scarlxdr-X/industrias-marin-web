---
import "../styles/global.css";
import "../styles/animaciones.css";
import Intro from "../components/Intro.astro";
import { publicada } from "../data/sitio";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import WhatsAppFlotante from "../components/WhatsAppFlotante.astro";

interface Props {
  titulo: string;
  descripcion?: string;
  noindex?: boolean;   // true en páginas que Google no debe mostrar (ej: /admin)
  intro?: boolean;     // true solo en el inicio: muestra la intro con el logo
}

const {
  titulo,
  noindex = false,
  intro = false,
  descripcion = "Diseño y fabricación de muebles en madera inmunizada y secada al horno. Alcobas, salas, comedores y cocinas a la medida en El Cerrito, Valle del Cauca.",
} = Astro.props;
---

<html lang="es">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{titulo}</title>
    <meta name="description" content={descripcion} />
    <meta property="og:title" content={titulo} />
    <meta property="og:description" content={descripcion} />
    <meta property="og:type" content="website" />
    {(noindex || !publicada) && <meta name="robots" content="noindex, nofollow" />}
    <script is:inline>
      // Activa las animaciones de scroll solo si el navegador puede mostrarlas.
      // Si en 3 s el script de animaciones no cargó, se desactivan para no dejar nada oculto.
      if ("IntersectionObserver" in window && !matchMedia("(prefers-reduced-motion: reduce)").matches) {
        var raiz = document.documentElement;
        raiz.classList.add("js-animar");
        setTimeout(function () {
          if (!raiz.classList.contains("animaciones-listas")) raiz.classList.remove("js-animar");
        }, 3000);
      }
    </script>
  </head>
  <body>
    {intro && <Intro />}
    <Header />
    <main>
      <slot />
    </main>
    <Footer />
    <WhatsAppFlotante />

    <script>
      import "../scripts/animaciones";
    </script>

    <script>
      // El código del modo administrador solo se descarga si quien navega inició sesión.
      // Los visitantes normales no cargan nada de esto.
      if (document.cookie.split("; ").includes("marin_admin=1")) {
        import("../scripts/admin/modo-admin");
      }
    </script>
  </body>
</html>