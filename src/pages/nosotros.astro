---
import { Image } from "astro:assets";
import Base from "../layouts/Base.astro";
import Valores from "../components/Valores.astro";
import Reconocimientos from "../components/Reconocimientos.astro";
import { empresa } from "../data/empresa";
import { fotoMarca } from "../data/marca";

const foto = fotoMarca("nosotros.webp");
const taller = fotoMarca("taller.webp");

const hitos = [
  { anio: String(empresa.desde), texto: "Nacemos en un pequeño local de El Cerrito, con pocos recursos y mucha iniciativa." },
  { anio: "Hoy", texto: "Terreno propio con planta de producción, área administrativa y sala de exhibición." },
  { anio: "≈50", texto: "familias de la región trabajan con nosotros: ebanistas, pintores, lijadores, tapiceros y administrativos." },
];
---

<Base
  titulo="Nosotros | Industrias Marín"
  descripcion="Empresa familiar fundada en 1988 en El Cerrito, Valle del Cauca. Conoce nuestra historia, misión, visión y los reconocimientos que hemos recibido."
>
  <!-- Encabezado -->
  <section class="portada">
    <div class="contenedor portada__interior">
      <div class="portada__texto">
        <nav class="migas" aria-label="Ruta">
          <a href="/">Inicio</a> <span aria-hidden="true">/</span>
          <span aria-current="page">Nosotros</span>
        </nav>
        <p class="etiqueta">Empresa familiar desde {empresa.desde}</p>
        <h1>Nuestra <em>historia</em></h1>
        <p class="portada__bajada">
          Más de 30 años convirtiendo madera en muebles para los hogares y oficinas de Colombia,
          desde El Cerrito, Valle del Cauca.
        </p>
      </div>
      {foto && (
        <div class="portada__foto">
          <Image src={foto} alt="Carpintero trabajando una pieza de madera" widths={[640, 1000, 1400]} sizes="(max-width: 860px) 100vw, 50vw" loading="eager" />
        </div>
      )}
    </div>
  </section>

  <!-- Historia -->
  <section class="relato">
    <div class="contenedor relato__interior">
      <div class="relato__texto" data-revelar>
        <h2>De un pequeño local <em>a una planta propia</em></h2>
        <p>
          Industrias Marín es una empresa familiar que nació en {empresa.desde} con pocos recursos
          y mucha iniciativa. Gracias al crecimiento y al trabajo de todo un equipo, adquirimos el
          terreno donde hoy funcionan nuestra planta de producción, el área administrativa y la
          sala de exhibición.
        </p>
        <p>
          Contamos con ebanistas, pintores, lijadores, tapiceros y personal administrativo, y
          apoyamos a cerca de 50 familias de la región. Con la transformación de la madera hemos
          contribuido a que El Cerrito sea reconocido a nivel nacional.
        </p>
      </div>

      <ol class="hitos">
        {hitos.map((h) => (
          <li data-revelar>
            <span class="hitos__anio">{h.anio}</span>
            <p>{h.texto}</p>
          </li>
        ))}
      </ol>
    </div>
  </section>

  <!-- Misión y visión -->
  <section class="proposito">
    <div class="contenedor proposito__grid">
      <article class="proposito__tarjeta" data-revelar>
        <span class="proposito__icono" aria-hidden="true">
          <svg viewBox="0 0 24 24"><circle cx="12" cy="12" r="9" /><circle cx="12" cy="12" r="5" /><circle cx="12" cy="12" r="1.5" /></svg>
        </span>
        <p class="etiqueta">Misión</p>
        <p class="proposito__texto">
          Satisfacer las necesidades de decoración de nuestros clientes con muebles en madera y
          accesorios de calidad, ofreciendo un servicio confiable, innovación, creatividad y
          compromiso con la protección del medio ambiente.
        </p>
      </article>
      <article class="proposito__tarjeta proposito__tarjeta--oscura" data-revelar>
        <span class="proposito__icono" aria-hidden="true">
          <svg viewBox="0 0 24 24"><path d="M2 12s3.6-7 10-7 10 7 10 7-3.6 7-10 7S2 12 2 12Z" /><circle cx="12" cy="12" r="3" /></svg>
        </span>
        <p class="etiqueta">Visión</p>
        <p class="proposito__texto">
          Ser reconocidos como la empresa líder en diseño, producción y distribución de muebles
          en madera para el hogar y la oficina.
        </p>
      </article>
    </div>
  </section>

  <Valores titulo />

  <Reconocimientos variante="galeria" />

  <!-- Invitación -->
  <section class="invitacion">
    <div class="contenedor invitacion__interior" data-revelar>
      {taller && <Image class="invitacion__foto" src={taller} alt="" width={240} height={250} />}
      <div>
        <h2>Ven a conocer <em>nuestra planta</em></h2>
        <p>{empresa.direccion.linea1}, {empresa.direccion.linea2}. {empresa.horario}</p>
      </div>
      <div class="invitacion__botones">
        <a href="/#visitanos" class="boton boton--morado">Cómo llegar</a>
        <a href={empresa.whatsapp} class="boton boton--borde">Escríbenos</a>
      </div>
    </div>
  </section>
</Base>

<style>
  .migas { font-size: 14px; color: var(--texto-suave); display: flex; gap: 8px; flex-wrap: wrap; }
  .migas a { color: var(--texto-suave); }

  /* Encabezado */
  .portada { background: var(--lavanda); border-bottom: 1px solid var(--borde); overflow: hidden; }
  .portada__interior {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
    gap: 48px;
    align-items: center;
    padding-block: 48px 64px;
  }
  .portada__texto { display: grid; gap: 16px; }
  .portada h1 { font-size: clamp(52px, 7vw, 84px); }
  .portada__bajada { margin: 0; font-size: 19px; color: #4A4155; max-width: 480px; }
  .portada__foto {
    height: 420px;
    border-radius: 4px 120px 4px 4px;
    overflow: hidden;
  }
  .portada__foto :global(img) { width: 100%; height: 100%; object-fit: cover; }

  /* Historia */
  .relato { padding-block: var(--espacio-seccion); }
  .relato__interior {
    display: grid;
    grid-template-columns: minmax(0, 1.2fr) minmax(0, 1fr);
    gap: 64px;
    align-items: start;
  }
  .relato__texto { display: grid; gap: 18px; }
  .relato h2 { font-size: clamp(36px, 4.4vw, 52px); }
  .relato p { margin: 0; color: #4A4155; font-size: 18px; }

  .hitos {
    list-style: none;
    margin: 0;
    padding: 0 0 0 28px;
    border-left: 2px solid var(--cobre);
    display: grid;
    gap: 28px;
  }
  .hitos li { position: relative; display: grid; gap: 4px; }
  .hitos li::before {
    content: "";
    position: absolute;
    left: -36px;
    top: 10px;
    width: 14px;
    height: 14px;
    border-radius: 50%;
    background: var(--blanco);
    border: 3px solid var(--cobre);
  }
  .hitos__anio {
    font-family: var(--fuente-titulos);
    font-size: 36px;
    font-weight: 600;
    line-height: 1;
    color: var(--morado);
  }
  .hitos p { margin: 0; color: var(--texto-suave); }

  /* Misión y visión */
  .proposito { padding-bottom: var(--espacio-seccion); }
  .proposito__grid { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 24px; }
  .proposito__tarjeta {
    display: grid;
    gap: 14px;
    align-content: start;
    padding: clamp(28px, 4vw, 48px);
    border-radius: 6px 6px 6px 64px;
    background: var(--lavanda);
    border: 1px solid var(--borde);
  }
  .proposito__tarjeta--oscura { background: var(--berenjena); border-color: var(--berenjena); border-radius: 64px 6px 6px 6px; }
  .proposito__tarjeta--oscura .etiqueta { color: var(--cobre-claro); }
  .proposito__tarjeta--oscura .proposito__texto { color: #E7DCF2; }
  .proposito__icono {
    width: 56px;
    height: 56px;
    border-radius: 50%;
    display: grid;
    place-items: center;
    background: var(--blanco);
    color: var(--cobre);
  }
  .proposito__icono svg { width: 28px; height: 28px; fill: none; stroke: currentColor; stroke-width: 1.8; }
  .proposito__texto {
    margin: 0;
    font-family: var(--fuente-titulos);
    font-size: clamp(24px, 2.4vw, 30px);
    line-height: 1.3;
    color: var(--morado);
  }

  /* Invitación */
  .invitacion { padding-block: var(--espacio-seccion); }
  .invitacion__interior {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 24px 40px;
    padding: 28px;
    border-radius: 10px;
    border: 1px solid var(--borde);
  }
  .invitacion__foto { width: 120px; height: 125px; object-fit: cover; border-radius: 6px 40px 6px 6px; }
  .invitacion__interior > div:nth-child(2) { flex: 1 1 320px; display: grid; gap: 6px; }
  .invitacion h2 { font-size: clamp(30px, 3.4vw, 40px); }
  .invitacion p { margin: 0; color: var(--texto-suave); }
  .invitacion__botones { display: flex; flex-wrap: wrap; gap: 12px; }

  @media (max-width: 860px) {
    .portada__interior, .relato__interior, .proposito__grid { grid-template-columns: 1fr; }
    .portada__foto { height: 300px; }
    .relato__interior { gap: 40px; }
  }
</style>
