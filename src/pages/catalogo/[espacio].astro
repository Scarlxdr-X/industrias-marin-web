---
// Página de un espacio (ej: /catalogo/alcoba).
// - Si el espacio tiene varias categorías: muestra una tarjeta grande por categoría.
// - Si tiene una sola (ej: Cocina): muestra directamente sus muebles.
import Base from "../../layouts/Base.astro";
import CabeceraCatalogo from "../../components/CabeceraCatalogo.astro";
import TarjetaCategoria from "../../components/TarjetaCategoria.astro";
import ListaProductos from "../../components/ListaProductos.astro";
import { espacios, type Espacio } from "../../data/espacios";
import { obtenerProductos } from "../../data/productos";

export function getStaticPaths() {
  return espacios.map((espacio) => ({ params: { espacio: espacio.slug }, props: { espacio } }));
}

interface Props {
  espacio: Espacio;
}
const { espacio } = Astro.props;

const productos = (await obtenerProductos()).filter((p) => p.espacio === espacio.slug);
const grupos = espacio.categorias.map((categoria) => ({
  categoria,
  items: productos.filter((p) => p.categoria === categoria),
}));
const unaSola = grupos.length === 1;
const total = productos.length;
---

<Base
  titulo={`${espacio.nombre} | Industrias Marín`}
  descripcion={`Muebles para ${espacio.nombre.toLowerCase()} en madera: ${espacio.categorias.join(", ")}. Fabricados a la medida en El Cerrito, Valle.`}
>
  <CabeceraCatalogo
    migas={[{ texto: "Inicio", href: "/" }, { texto: "Catálogo", href: "/#productos" }, { texto: espacio.nombre }]}
    titulo={espacio.nombre}
    bajada={unaSola
      ? `${total} ${total === 1 ? "modelo" : "modelos"} · todos se pueden hacer a tu medida`
      : `${espacio.categorias.join(" · ")} · ${total} modelos`}
  />

  {unaSola ? (
    <div class="contenedor">
      <ListaProductos categoria={grupos[0].categoria} productos={grupos[0].items} />
    </div>
  ) : (
    <div class="contenedor categorias">
      {grupos.map((g, i) => (
        <TarjetaCategoria categoria={g.categoria} productos={g.items} indice={i} />
      ))}
    </div>
  )}
</Base>

<style>
  .categorias {
    padding-block: 48px 96px;
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(420px, 100%), 1fr));
    gap: 28px;
  }
</style>
